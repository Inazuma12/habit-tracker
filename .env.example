# Identifiant UUID de l'application créée dans Enable Banking Control Panel.
ENABLE_BANKING_APPLICATION_ID=

# Chemin vers la clé privée .pem téléchargée lors de la création de l'application.
ENABLE_BANKING_PRIVATE_KEY_PATH=./secrets/enable-banking-private.pem

APP_URL=https://localhost:5173
BANK_API_PORT=8787

# Fichier Coinbase App ECDSA téléchargé avec l'autorisation View uniquement.
COINBASE_CREDENTIALS_PATH=./secrets/coinbase-api-key.json
